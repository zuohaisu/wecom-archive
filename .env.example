# ============================================================
# 365 WeCom Archive — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
APP_NAME="365 WeCom Archive"
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wecom_archive
DB_USER=postgres
DB_PASSWORD=change-me

# Constructed automatically from above — or set directly:
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/wecom_archive

# ------------------------------------------------------------
# WeCom SDK
# ------------------------------------------------------------
# Absolute path to the WeCom C SDK shared library on the server.
# On the production server: /srv/apps/wecom-archive-365/shared/sdk/sdk_20240606/20240606/C_sdk/libWeWorkFinanceSdk_C.so
# For local smoke tests set this to a copy of the .so file accessible on your machine.
WECOM_SDK_LIB_PATH=

# ------------------------------------------------------------
# WeCom Conversation Archive
# ------------------------------------------------------------
WECOM_CORP_ID=
WECOM_ARCHIVE_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_ENCODING_AES_KEY=
WECOM_PRIVATE_KEY_PATH=./private_keys/wecom_archive_private_key.pem
WECOM_PUBLIC_KEY_VERSION=
WECOM_AGENT_ID=
WECOM_OAUTH_SECRET=

# ------------------------------------------------------------
# Tenant / Admin Console (RND-110 WeCom employee login)
# ------------------------------------------------------------
# ADMIN_DOMAIN — domain registered in WeCom Admin as the OAuth trusted domain.
# No protocol, no port, no path. Example: admin.yourcompany.com
# Used to construct the OAuth redirect_uri: https://{ADMIN_DOMAIN}/api/auth/wecom/callback
# Also register this domain in: WeCom Admin → App Management → [Your App]
#   → Developer Settings → Web Authorization & JS-SDK Domain (网页授权及JS-SDK域名)
# When unset, OAuth login falls back to http://localhost:8035 (dev only, HTTP not supported by WeCom in prod).
ADMIN_DOMAIN=

# WECOM_OAUTH_SECRET — the App Secret from WeCom Admin → App Management → [Your App] → Show Secret.
# Used ONLY for OAuth (user identity). Different from WECOM_ARCHIVE_SECRET (archive pull).
# Do NOT log or expose this value. Already defined above under "WeCom Conversation Archive".

# ------------------------------------------------------------
# Auth Mode (RND-112 — temporary password fallback)
# ------------------------------------------------------------
# AUTH_MODE controls which login method is active:
#   wecom    — WeCom OAuth employee login (RND-110, default).
#              Requires WECOM_CORP_ID, WECOM_AGENT_ID, WECOM_OAUTH_SECRET, ADMIN_DOMAIN.
#   password — Temporary username/password fallback (RND-112).
#              Use this ONLY until WeCom OAuth domain authorization is resolved in production.
#              Requires ADMIN_USERNAME and ADMIN_PASSWORD_HASH below.
# If AUTH_MODE is unset or unrecognized, the server defaults to 'wecom'.
# Fail safe: setting AUTH_MODE=password with no ADMIN_PASSWORD_HASH returns HTTP 500.
AUTH_MODE=wecom

# ADMIN_USERNAME — the admin login username for password mode (plain text, not secret by itself).
# ADMIN_PASSWORD_HASH — bcrypt-style PBKDF2 hash of the admin password.
#   DO NOT store the plaintext password here.
#   DO NOT commit real hash values to version control.
#
# To generate ADMIN_PASSWORD_HASH (from backend/):
#   python -c "from app.auth import hash_password; print(hash_password('your-password-here'))"
#
# Example output (not a real credential):
#   pbkdf2:sha256:260000:RANDOMSALT==:RANDOMHASH==
#
# The password endpoint (/api/auth/password/login) is a 404 when AUTH_MODE=wecom.
# Never log the hash value or the submitted password.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
STORAGE_BACKEND=local        # local | s3 | oss

# STORAGE_LOCAL_PATH — media storage root used by the authenticated image
# route (RND-144, GET /api/conversations/{id}/messages/{msgid}/media).
# media_files.local_path values must resolve (after following symlinks)
# to a location under this directory, or the route returns 404. Not
# required for app startup: if unset, image messages simply stay in their
# not_downloaded/unsupported placeholder state. Never printed in logs.
STORAGE_LOCAL_PATH=./data/media

# Alibaba Cloud OSS (used when STORAGE_BACKEND=oss)
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# ------------------------------------------------------------
# Sync
# ------------------------------------------------------------
SYNC_INTERVAL_SECONDS=300    # How often to pull new messages from WeCom
SYNC_LOOKBACK_DAYS=7         # On first run, how many days back to sync

# ------------------------------------------------------------
# Archive Worker Lock
# ------------------------------------------------------------
# Shared lock file path used by run_archive_worker_once.py to ensure
# only one worker (timer-triggered or event-triggered) runs at a time.
WORKER_LOCK_PATH=/srv/apps/wecom-archive-365/shared/run/wecom-archive-worker.lock
