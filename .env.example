# ============================================================
# 365 WeCom Archive — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
APP_ENV=development          # development | staging | production
# Set NONPROD_DEPLOYMENT=1 only in the isolated RND-392 staging EnvironmentFile.
# Production and ordinary local development leave it unset or 0.
NONPROD_DEPLOYMENT=0

# Field encryption key for credentials stored at rest. Generate locally with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
# Required at app runtime. FastAPI's DB session code does not fall back to DB_*.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/wecom_archive

# Optional compatibility values. Alembic can derive DATABASE_URL from these,
# but the app itself still requires DATABASE_URL above.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wecom_archive
DB_USER=postgres
DB_PASSWORD=change-me

# ------------------------------------------------------------
# WeCom SDK
# ------------------------------------------------------------
# Absolute path to the WeCom C SDK shared library on the server.
# On the production server: /srv/apps/wecom-archive-365/shared/sdk/sdk_20240606/20240606/C_sdk/libWeWorkFinanceSdk_C.so
# For local smoke tests set this to a copy of the .so file accessible on your machine.
WECOM_SDK_LIB_PATH=

# ------------------------------------------------------------
# WeCom Conversation Archive
# ------------------------------------------------------------
WECOM_CORP_ID=
WECOM_ARCHIVE_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_ENCODING_AES_KEY=
WECOM_PRIVATE_KEY_PATH=./private_keys/wecom_archive_private_key.pem
WECOM_PUBLIC_KEY_VERSION=
WECOM_AGENT_ID=
WECOM_OAUTH_SECRET=

# ------------------------------------------------------------
# WeCom third-party organization authorization (RND-346/RND-350)
# ------------------------------------------------------------
# Developer/service-provider suite credentials. Never reuse the archive app
# secret or archive callback credentials here. suite_ticket is received only
# through the independent encrypted instruction callback and stored encrypted;
# it is deliberately not an environment variable.
WECOM_THIRD_PARTY_SUITE_ID=
WECOM_THIRD_PARTY_SUITE_SECRET=
# Exact HTTPS OAuth authorization-code callback registered for the suite:
# /api/auth/wecom/third-party/callback
WECOM_THIRD_PARTY_CALLBACK_URL=
# Independent provider instruction callback credentials. Register the HTTPS
# URL ending in /api/wecom/third-party/instructions. Do not reuse
# WECOM_CALLBACK_TOKEN or WECOM_CALLBACK_ENCODING_AES_KEY.
WECOM_THIRD_PARTY_INSTRUCTION_TOKEN=
WECOM_THIRD_PARTY_INSTRUCTION_ENCODING_AES_KEY=

# ------------------------------------------------------------
# Public "start a 15-day free trial" login-page entry point (RND-396)
# ------------------------------------------------------------
# Only controls whether the trial CTA is discoverable on /admin/login. Keep
# disabled until non-prod E2E has passed and RND-353 gives a controlled
# production go for third-party self-service organization creation.
SELF_SERVICE_TRIAL_ENTRY_ENABLED=false

# ------------------------------------------------------------
# WeChat Pay API v3 Native annual-plan purchase (RND-380)
# ------------------------------------------------------------
# Keep disabled until the merchant account, callback HTTPS endpoint and
# production verification checklist in RND-390 are complete. When enabled,
# every value below is required and the app fails at startup if any value is
# missing or invalid. Never commit real keys.
WECHAT_PAY_ENABLED=false
# AppID bound to this merchant account.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
# Merchant API certificate serial used to sign outbound API v3 requests.
WECHAT_PAY_MERCHANT_SERIAL_NO=
# PEM PKCS#8/RSA private key. In an env file, encode line breaks as literal
# \n characters; the app normalizes them before parsing.
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
# Exactly 32 bytes. Used only to decrypt signed notification resources.
WECHAT_PAY_API_V3_KEY=
# WeChat Pay public-key mode is required; the ID must start with PUB_KEY_ID_.
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
# Exact public HTTPS URL; path must remain /api/payments/wechat/notify.
WECHAT_PAY_NOTIFY_URL=https://admin.example.com/api/payments/wechat/notify
# Exact public HTTPS refund callback; no query string is permitted.
WECHAT_PAY_REFUND_NOTIFY_URL=https://admin.example.com/api/refunds/wechat/notify

# ------------------------------------------------------------
# Archive-complete generic media dispatch (RND-343)
# ------------------------------------------------------------
# The callback → archive worker path is primary. After a successful archive
# commit, it wakes the existing generic Media Worker only when fresh/pending
# media exists. Set false only for an emergency rollback; the 30-minute media
# reconciliation timer remains the durable fallback either way.
EVENT_MEDIA_DOWNLOAD_ENABLED=true
# Bounded archive-complete wake-up window/batch. The generic pipeline covers
# image, voice, video, file, emotion, audio_archive and nested media refs.
EVENT_MEDIA_DOWNLOAD_BATCH_LIMIT=20
EVENT_MEDIA_DOWNLOAD_RECENT_WINDOW_HOURS=24
# Durable retry limit + exponential backoff shared by Media Worker timer runs.
EVENT_MEDIA_DOWNLOAD_RETRY_COUNT=3
EVENT_MEDIA_DOWNLOAD_BACKOFF_SECONDS=30
# Legacy RND-172 setting retained only for existing config-store compatibility;
# RND-343 has no in-process media sweep thread.
EVENT_MEDIA_DOWNLOAD_SWEEP_INTERVAL_SECONDS=15

# ------------------------------------------------------------
# Tenant / Admin Console (RND-110 WeCom employee login)
# ------------------------------------------------------------
# ADMIN_DOMAIN — domain registered in WeCom Admin as the OAuth trusted domain.
# No protocol, no port, no path. Example: admin.yourcompany.com
# Used to construct the OAuth redirect_uri: https://{ADMIN_DOMAIN}/api/auth/wecom/callback
# Also register this domain in: WeCom Admin → App Management → [Your App]
#   → Developer Settings → Web Authorization & JS-SDK Domain (网页授权及JS-SDK域名)
# When unset, OAuth login falls back to http://localhost:8035 (dev only, HTTP not supported by WeCom in prod).
ADMIN_DOMAIN=localhost

# WECOM_OAUTH_SECRET — the App Secret from WeCom Admin → App Management → [Your App] → Show Secret.
# Used ONLY for OAuth (user identity). Different from WECOM_ARCHIVE_SECRET (archive pull).
# Do NOT log or expose this value. Already defined above under "WeCom Conversation Archive".

# ------------------------------------------------------------
# Auth Mode (RND-112 — temporary password fallback)
# ------------------------------------------------------------
# AUTH_MODE controls which login method is active:
#   wecom    — WeCom OAuth employee login (RND-110, default).
#              Requires WECOM_CORP_ID, WECOM_AGENT_ID, WECOM_OAUTH_SECRET, ADMIN_DOMAIN.
#   password — Temporary username/password fallback (RND-112).
#              Use this ONLY until WeCom OAuth domain authorization is resolved in production.
#              Requires ADMIN_USERNAME and ADMIN_PASSWORD_HASH below.
# If AUTH_MODE is unset or unrecognized, the server defaults to 'wecom'.
# Fail safe: setting AUTH_MODE=password with no ADMIN_PASSWORD_HASH returns HTTP 500.
#
# Recommended for first local bring-up:
#   AUTH_MODE=password
# Then switch to AUTH_MODE=wecom only after the WeCom OAuth domain is working.
AUTH_MODE=password

# ADMIN_USERNAME — the admin login username for password mode (plain text, not secret by itself).
# ADMIN_PASSWORD_HASH — bcrypt-style PBKDF2 hash of the admin password.
#   DO NOT store the plaintext password here.
#   DO NOT commit real hash values to version control.
#
# To generate ADMIN_PASSWORD_HASH (from backend/):
#   python -c "from app.auth import hash_password; print(hash_password('your-password-here'))"
#
# Example output (not a real credential):
#   pbkdf2:sha256:260000:RANDOMSALT==:RANDOMHASH==
#
# The password endpoint (/api/auth/password/login) is a 404 when AUTH_MODE=wecom.
# Never log the hash value or the submitted password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------
# Password reset email (RND-278)
# ------------------------------------------------------------
# Leave SMTP_HOST or SMTP_FROM empty to use the safe console transport for
# password reset/invite previews; no real email is delivered in that mode and
# full-media export requests are rejected. SMTP uses implicit TLS (port 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# The ADMIN_DOMAIN host above is used in export-ready email links.
# The link opens an authenticated page; it is not a bearer download token.
# RND-360 export worker: one queued ZIP per run on the supported 2C2G host.
# Ready notices require real SMTP above and reuse ADMIN_DOMAIN for the
# authenticated export-center link; no additional export secret is required.
EXPORT_JOB_BATCH_SIZE=1
# RND-401 billing notification outbox: bounded intents per five-minute run.
# Real delivery requires SMTP above and a public HTTPS ADMIN_DOMAIN. Missing
# transport is recorded as retryable; console transport never marks mail sent.
BILLING_NOTIFICATION_BATCH_SIZE=20
# Full public base URL for reset links, e.g. https://archive.example.com.
# Leave unset to use ADMIN_DOMAIN.
PASSWORD_RESET_BASE_URL=
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
# MEDIA_STORAGE_PROVIDER selects the DEFAULT WRITE provider — i.e. where
# NEW media downloads are stored. It does NOT change how existing
# media_files rows are read: each row records its own storage_backend /
# storage_ref (migration 0005) and is always served through the provider
# recorded on it, regardless of this setting. This is what makes it safe
# to run mixed local + Qiniu media in the same deployment and to change
# this value without reinterpreting or migrating any existing row.
#
#   local       — filesystem storage under STORAGE_LOCAL_PATH (default, and
#                 the rollback target for NEW writes — see rollback note
#                 below).
#   qiniu_kodo  — Qiniu Kodo object storage (RND-174). Requires all of the
#                 QINIU_* variables below; the app fails clearly at
#                 provider-construction time (never falls back to local) if
#                 any of them are missing. Requires the `qiniu` package —
#                 run `pip install -r requirements.txt` before enabling.
# Defaults to STORAGE_BACKEND, then "local", if unset.
#
# ROLLBACK NOTE: switching this back to "local" only affects new writes.
# Rows already written to Qiniu keep storage_backend=qiniu_kodo and keep
# requiring valid QINIU_* credentials to remain servable — removing Qiniu
# credentials while such rows exist makes those specific rows unavailable
# (existing local rows are unaffected). Fully retiring Qiniu requires
# migrating those rows' bytes back to local storage first (RND-186, not
# yet implemented) before removing credentials.
MEDIA_STORAGE_PROVIDER=local
STORAGE_BACKEND=local        # local | s3 | oss (legacy alias, see above)

# STORAGE_LOCAL_PATH — media storage root used by the authenticated image
# route (RND-144, GET /api/conversations/{id}/messages/{msgid}/media) for
# rows with storage_backend=local. media_files.storage_ref (or, for rows
# predating migration 0005, local_path) values must resolve (after
# following symlinks) to a location under this directory, or the route
# returns 404. Not required for app startup: if unset, image messages
# simply stay in their not_downloaded/unsupported placeholder state.
# Never printed in logs.
STORAGE_LOCAL_PATH=./data/media

# ------------------------------------------------------------
# Qiniu Kodo (RND-174) — read whenever qiniu_kodo is selected, either as
# MEDIA_STORAGE_PROVIDER (new writes) or as an individual row's
# storage_backend (existing Qiniu-backed rows being read). Never logged.
# Never returned to the frontend. The bucket is assumed private — this
# app always proxies media through the authenticated backend route; it
# never issues a public/permanent object URL.
# ------------------------------------------------------------
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# QINIU_REGION — optional; a Qiniu region id (e.g. z0, z1, z2, na0, as0).
# Leave unset to let the SDK auto-discover the bucket's region.
QINIU_REGION=
# QINIU_DOMAIN — the bucket's bound access domain, as a FULL HTTPS BASE
# URL, e.g. https://private-media.example.com (no trailing slash needed —
# one is stripped if present). http:// and bare hostnames (no scheme) are
# REJECTED at startup/provider-construction time — this is validated, not
# just documented, so a misconfiguration fails loudly instead of silently
# serving over plaintext. Used server-side to build short-lived private
# download requests: internally for the raw media proxy route (60s,
# RND-174), and — since RND-187 — as the base of the client-facing signed
# URL returned by GET .../media/access, which the browser does fetch
# directly. The domain itself is not secret; only the signed URL's query
# string (token/expiry) is time-boxed and must never be logged.
#
# RND-207 — CDN vs ORIGIN domain: this may be either a Qiniu CDN
# acceleration domain (旧: media.example.com) or a Qiniu ORIGIN/source
# domain (新: media-origin.example.com). The application code is identical
# for both — it only signs against whatever base URL is set here. Migrating
# off CDN onto an origin domain is therefore a value change to THIS variable
# only, with no code change. Signed private-download URLs must be verified
# to work on the chosen domain type before switching production (see
# docs/rnd-207-migration-runbook.md).
QINIU_DOMAIN=
# QINIU_TIMEOUT_SECONDS — optional per-request timeout for Qiniu SDK/HTTP
# calls (default 30).
QINIU_TIMEOUT_SECONDS=30
# MEDIA_SIGNED_URL_TTL_SECONDS — optional (RND-187). TTL, in seconds, for
# the Signed URL returned by GET .../media/access for Qiniu-backed media.
# Default 900 (15 minutes) when unset. Allowed range 60-3600; an
# out-of-range or non-integer value fails the request with a configuration
# error rather than silently clamping.
MEDIA_SIGNED_URL_TTL_SECONDS=900
# ARCHIVE_DOMAIN — public hostname of the archive app, used by
# scripts/deploy_server.sh as the base URL for the public health check gate.
# Must match the nginx server_name that proxies to 127.0.0.1:8035.
# If unset, deploy_server.sh defaults to 'archive.example.com' (placeholder).
ARCHIVE_DOMAIN=
# MEDIA_SIGNED_URL_WINDOW_SECONDS — optional (RND-207). When set, the signed
# URL's absolute expiry is snapped to a fixed time window boundary so that
# repeated requests for the SAME object within that window return a
# byte-for-byte identical URL. This lets the browser HTTP-cache the media
# bytes across page reloads / re-renders instead of re-downloading on every
# fresh signature. Defaults to MEDIA_SIGNED_URL_TTL_SECONDS when unset.
# Guaranteed remaining lifetime of an issued URL is >= this window (bounded
# to the same 60-3600 range as the TTL).
MEDIA_SIGNED_URL_WINDOW_SECONDS=

# ------------------------------------------------------------
# Thumbnails (RND-207) — server-side list/timeline thumbnails
# ------------------------------------------------------------
# MEDIA_THUMBNAIL_ENABLED — optional; "true"/"false" (default true). When
# false, no thumbnails are generated on new downloads and the backfill
# script is a no-op; the list falls back to serving originals.
MEDIA_THUMBNAIL_ENABLED=true
# MEDIA_THUMBNAIL_MAX_EDGE — optional; longest-edge pixel cap for generated
# thumbnails (default 360). The list caps display at ~280px; 360 gives a
# little headroom for higher-DPI screens without loading originals.
MEDIA_THUMBNAIL_MAX_EDGE=360
# MEDIA_THUMBNAIL_JPEG_QUALITY — optional; JPEG quality 1-95 (default 82).
# Only affects opaque images (transparent images are emitted as PNG).
MEDIA_THUMBNAIL_JPEG_QUALITY=82

# ------------------------------------------------------------
# Voice playback variants (RND-258)
# ------------------------------------------------------------
# VOICE_TRANSCODE_ENABLED — optional; true by default. New voice and
# meeting-recording downloads are converted once into a co-located MP3 (WAV
# fallback) for browser playback. Set false to retain original-only behavior.
VOICE_TRANSCODE_ENABLED=true

# ------------------------------------------------------------
# Optional script-only knobs
# ------------------------------------------------------------
# sync_wecom_archive_once.py
WECOM_CHAT_LIMIT=500

# smoke_wecom_get_chat_data.py only
WECOM_CHAT_SEQ=0

# External-contact current profile/remark sync. Required by the durable
# callback/inbound-message refresh worker and daily full reconciliation; leave
# unset only to intentionally disable external-contact metadata sync.
WECOM_EXTERNAL_CONTACT_SECRET=

# One event worker run refreshes at most this many coalesced contact records.
# It is intentionally small so callbacks and archive decrypts never wait on
# external-contact API I/O.
EXTERNAL_CONTACT_REFRESH_BATCH_SIZE=25

# download_wecom_media_once.py only
WECOM_MEDIA_TIMEOUT=30

# ------------------------------------------------------------
# Archive Worker Lock
# ------------------------------------------------------------
# Shared lock file path used by run_archive_worker_once.py to ensure
# only one worker (timer-triggered or event-triggered) runs at a time.
WORKER_LOCK_PATH=/srv/apps/wecom-archive-365/shared/run/wecom-archive-worker.lock

# Lock file path used by the manual one-shot
# scripts/download_wecom_media_once.py (RND-147/RND-199, the unified media
# download pipeline) so two concurrent invocations never race on the same
# candidates. Not required — defaults to the path below if unset.
MEDIA_DOWNLOAD_LOCK_PATH=/srv/apps/wecom-archive-365/shared/run/wecom-media-download.lock

# Lock file path used by the manual, repeatable
# scripts/migrate_local_media_to_qiniu.py (RND-186 — historical Local ->
# Qiniu media migration) so two concurrent invocations never race on the
# same candidates. Not required — defaults to the path below if unset.
# This tool always writes to Qiniu regardless of MEDIA_STORAGE_PROVIDER, so
# the QINIU_* variables above must be set whenever it is run, even if the
# deployment's default WRITE provider is still "local".
MEDIA_MIGRATION_LOCK_PATH=/srv/apps/wecom-archive-365/shared/run/wecom-media-migration.lock

# Lock file path used by the manual, repeatable
# scripts/backfill_thumbnails_once.py (RND-207 — historical thumbnail
# backfill) so two concurrent invocations never race on the same candidates.
# Not required — defaults to the path below if unset.
MEDIA_THUMBNAIL_BACKFILL_LOCK_PATH=/srv/apps/wecom-archive-365/shared/run/wecom-thumbnail-backfill.lock

# Lock file used by scripts/backfill_voice_transcode_once.py (RND-258).
MEDIA_VOICE_TRANSCODE_BACKFILL_LOCK_PATH=/srv/apps/wecom-archive-365/shared/run/wecom-voice-transcode-backfill.lock

# ------------------------------------------------------------
# AI Support (RND-354 epic) — see docs/ai/eval-and-quality-gate.md
# ------------------------------------------------------------
# Single kill switch every AI surface reads (T2 answer service, T3 UI, T5
# reindex/eval jobs). Not required — defaults to disabled.
AI_SUPPORT_ENABLED=false

# "" | "deepseek" | "fake". Required (non-empty) whenever AI_SUPPORT_ENABLED
# is true — there is no silent default provider.
AI_LLM_PROVIDER=

# Exact model id as published by the provider — never guessed/hardcoded in
# code. Required when AI_LLM_PROVIDER=deepseek.
AI_LLM_MODEL=

# Required when AI_LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Per-tenant per-UTC-day token budget (prompt+completion) before
# answer_service refuses further model calls with a deterministic
# budget_exceeded response. Not required — empty/unset means no cap.
AI_DAILY_TOKEN_BUDGET_PER_TENANT=

# Days an AI chat session (and its messages) is retained before
# scripts/run_ai_retention_sweep_once.py deletes it. Not required —
# defaults to 90.
AI_RETENTION_DAYS=90

# ------------------------------------------------------------
# Static Homepage Deploy (scripts/deploy_server.sh step 8)
# ------------------------------------------------------------
# Directory name (under shared/www and /var/www) that
# static_site/company_homepage/ is copied to on every deploy. Must match
# the `root` in the operator-managed Nginx config for crowntime.cn/
# www.crowntime.cn — see static_site/company_homepage/README.md. If the
# two diverge, the deploy keeps "succeeding" while silently writing to a
# directory Nginx never serves. Not required — defaults to "site".
STATIC_SITE_DIR_NAME=site
