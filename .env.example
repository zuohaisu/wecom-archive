# ============================================================
# 365 WeCom Archive — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
APP_NAME="365 WeCom Archive"
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wecom_archive
DB_USER=postgres
DB_PASSWORD=change-me

# Constructed automatically from above — or set directly:
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/wecom_archive

# ------------------------------------------------------------
# WeCom SDK
# ------------------------------------------------------------
# Absolute path to the WeCom C SDK shared library on the server.
# On the production server: /srv/apps/wecom-archive-365/shared/sdk/sdk_20240606/20240606/C_sdk/libWeWorkFinanceSdk_C.so
# For local smoke tests set this to a copy of the .so file accessible on your machine.
WECOM_SDK_LIB_PATH=

# ------------------------------------------------------------
# WeCom Conversation Archive
# ------------------------------------------------------------
WECOM_CORP_ID=
WECOM_ARCHIVE_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_ENCODING_AES_KEY=
WECOM_PRIVATE_KEY_PATH=./private_keys/wecom_archive_private_key.pem
WECOM_PUBLIC_KEY_VERSION=
WECOM_AGENT_ID=
WECOM_OAUTH_SECRET=
WECOM_REDIRECT_URI=http://localhost:8035/auth/wecom/callback
ADMIN_WECOM_USERIDS=

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
STORAGE_BACKEND=local        # local | s3 | oss
STORAGE_LOCAL_PATH=./data/media

# Alibaba Cloud OSS (used when STORAGE_BACKEND=oss)
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# ------------------------------------------------------------
# Sync
# ------------------------------------------------------------
SYNC_INTERVAL_SECONDS=300    # How often to pull new messages from WeCom
SYNC_LOOKBACK_DAYS=7         # On first run, how many days back to sync

# ------------------------------------------------------------
# Archive Worker Lock
# ------------------------------------------------------------
# Shared lock file path used by run_archive_worker_once.py to ensure
# only one worker (timer-triggered or event-triggered) runs at a time.
WORKER_LOCK_PATH=/srv/apps/wecom-archive-365/shared/run/wecom-archive-worker.lock
