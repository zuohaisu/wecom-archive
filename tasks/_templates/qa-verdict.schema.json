{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crowntime.example/schemas/qa-verdict.schema.json",
  "title": "QA Verdict",
  "description": "独立验收 agent 的结构化判定输出。适配本项目的 GitHub Issue RND-* 工单、make verify 验证闸和 PR-first 流程。",
  "type": "object",
  "required": [
    "schema_version",
    "issue_key",
    "run_id",
    "qa_attempt",
    "verdict",
    "review_target",
    "acceptance_criteria",
    "commands",
    "safety_checks",
    "scope_violation",
    "recommended_next_state"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "issue_key": {
      "type": "string",
      "pattern": "^RND-[0-9]+$",
      "description": "工单标识，如 RND-326（GitHub Issue 标题前缀）"
    },
    "linear_url": { "type": "string", "format": "uri" },
    "run_id": {
      "type": "string",
      "description": "本次验收标识，建议 rnd-<n>-qa-<YYYYMMDD>-<seq>"
    },
    "qa_attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "第几轮验收。有界修复最多 2 轮，故最大 3（初验 + 2 轮复验）"
    },
    "verdict": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "review_target": {
      "type": "object",
      "required": ["base", "head", "diff_scope"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string", "description": "对比基线 commit，如 0aacc2a (main)" },
        "head": {
          "type": "string",
          "description": "被验对象，通常为交付分支上当前工单的 working tree diff；若已有批准提交则记录本票唯一 commit 的 SHA"
        },
        "diff_scope": {
          "type": "string",
          "description": "改动文件与增删行数摘要，并显式声明未触碰的范围"
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "status": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "每条为测试名 / file:line / 命令 exit code。禁止写「看起来对」这类主观描述。"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "result"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "result": { "type": "string", "description": "含 EXIT=<code>" }
        }
      }
    },
    "safety_checks": {
      "type": "object",
      "required": [
        "no_secrets_introduced",
        "no_commit_or_push",
        "file_ownership_respected",
        "architecture_boundary_pass",
        "i18n_all_locales",
        "no_template_engine_syntax"
      ],
      "additionalProperties": false,
      "properties": {
        "no_secrets_introduced": { "type": "boolean" },
        "no_commit_or_push": {
          "type": "boolean",
          "description": "QA agent 未 commit/push，且开发侧不存在未经 Haisu 批准的 commit/push 或直接 main 写入"
        },
        "file_ownership_respected": {
          "type": "boolean",
          "description": "git status 中所有改动文件都属于本工单拥有清单（错峰并行的前提）"
        },
        "architecture_boundary_pass": {
          "type": "boolean",
          "description": "backend/tests/test_architecture_boundary.py 通过"
        },
        "i18n_all_locales": {
          "type": "boolean",
          "description": "新增 i18n key 在 zh-CN / zh-TW / en 三个块中都存在；无界面文案则为 true"
        },
        "no_template_engine_syntax": {
          "type": "boolean",
          "description": "模板中无 Jinja 语法（本项目 render_template 只做 __TOKEN__ 替换）"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "type", "summary", "evidence", "required_fix"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^QA-[0-9]{3}$" },
          "severity": { "enum": ["blocker", "major", "minor"] },
          "type": {
            "enum": [
              "INSUFFICIENT_TEST_COVERAGE",
              "SCOPE_VIOLATION",
              "SECURITY_VIOLATION",
              "IMPLEMENTATION_DEFECT",
              "REGRESSION",
              "I18N_INCOMPLETE",
              "ARCHITECTURE_VIOLATION"
            ]
          },
          "summary": { "type": "string" },
          "evidence": { "type": "string", "description": "file:line 或命令输出" },
          "required_fix": {
            "type": "string",
            "description": "窄范围修复指令。不得借机扩大 scope。"
          }
        }
      }
    },
    "scope_violation": {
      "type": "boolean",
      "description": "是否存在超出 In scope 的改动"
    },
    "recommended_next_state": {
      "enum": ["PASS", "FIXING", "BLOCKED_NEEDS_HUMAN"]
    },
    "notes": { "type": "string" }
  }
}
