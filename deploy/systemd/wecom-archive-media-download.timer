[Unit]
Description=WeCom Archive Generic Media Reconciliation Timer — default every 30 minutes

[Timer]
# Archive reconciliation runs at :00/:30. This generic pending/retryable
# reconciliation runs at :15/:45, leaving a 15-minute default offset on
# 2-core hosts. The existing media lock still collapses manual/event/timer
# overlap safely.
OnCalendar=*:15/30
AccuracySec=30s
Persistent=true
Unit=wecom-archive-media-download.service

[Install]
WantedBy=timers.target
