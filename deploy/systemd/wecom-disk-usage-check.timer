[Unit]
Description=WeCom Archive Disk/Log/Backup Capacity Check Timer — runs every 15 minutes

[Timer]
# RND-343: offset (:09/:24/:39/:54) stays clear of archive reconciliation
# (:00/:30) and generic media reconciliation (:15/:45), preserving the
# low-resource timer stagger without changing this check's cadence.
OnCalendar=*:9/15
AccuracySec=30s
Persistent=true
Unit=wecom-disk-usage-check.service

[Install]
WantedBy=timers.target
