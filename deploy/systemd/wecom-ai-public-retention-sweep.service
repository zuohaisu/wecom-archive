[Unit]
Description=WeCom Archive Public AI Support Chat Session Retention Sweep
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=wecomarchive
WorkingDirectory=/srv/apps/wecom-archive-365/current/backend
EnvironmentFile=/srv/apps/wecom-archive-365/current/backend/.env
ExecStart=/srv/apps/wecom-archive-365/current/backend/.venv/bin/python scripts/run_ai_public_retention_sweep_once.py

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/apps/wecom-archive-365
ReadOnlyPaths=/usr /etc
PrivateTmp=true

[Install]
WantedBy=multi-user.target
