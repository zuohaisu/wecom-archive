[Unit]
Description=WeCom Archive Worker — sync + decrypt (one shot)
After=network-online.target postgresql.service
Wants=network-online.target
# GH-107: alert on unit failure (see deploy/systemd/wecom-job-failure-alert@.service)
OnFailure=wecom-job-failure-alert@%n.service

[Service]
Type=oneshot
User=wecomarchive
WorkingDirectory=/srv/apps/wecom-archive-365/current/backend
EnvironmentFile=/srv/apps/wecom-archive-365/current/backend/.env
Environment=ARCHIVE_WORKER_TRIGGER_SOURCE=timer
# The shared EnvironmentFile retains the legacy pair temporarily for other
# workloads. This versioned unit must never let those ambient selectors choose
# the archive mode: the worker enters all-active-tenants unless an explicit
# tenant dispatch supplies WECOM_TENANT_ID.
ExecStart=/usr/bin/env -u WECOM_CORP_ID -u WECOM_ARCHIVE_SECRET /srv/apps/wecom-archive-365/current/backend/.venv/bin/python scripts/run_archive_worker_once.py

# Security hardening (safe subset — must not break access to any of:
# backend directory, .env, SQLite/database path, private key path,
# SDK library path, shared lock path)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/apps/wecom-archive-365
ReadOnlyPaths=/usr /etc

# Do NOT use PrivateTmp=true — the shared lock path lives on the real
# filesystem and must be visible to both timer-triggered and
# event-triggered workers.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
