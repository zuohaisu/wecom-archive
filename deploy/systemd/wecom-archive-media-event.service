[Unit]
Description=WeCom Archive Generic Media Event Wake-up (RND-343, one shot)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=wecomarchive
WorkingDirectory=/srv/apps/wecom-archive-365/current/backend
EnvironmentFile=/srv/apps/wecom-archive-365/current/backend/.env
# Reuses the sole generic media CLI entrypoint; this is not a second downloader.
ExecStart=/srv/apps/wecom-archive-365/current/backend/.venv/bin/python scripts/download_wecom_media_once.py --since-hours 24 --newest-first --limit 20 --trigger-source archive-complete

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/apps/wecom-archive-365
ReadOnlyPaths=/usr /etc

# The generic media lock lives on the real shared filesystem.
PrivateTmp=false

