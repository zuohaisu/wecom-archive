[Unit]
Description=WeCom Archive Worker Reconciliation Timer — every 5 minutes

[Timer]
# Callback dispatch is the low-latency primary path. This is the durable
# reconciliation fallback every five minutes. It intentionally reuses this
# existing timer name; controlled deployment must never create a second timer.
OnCalendar=*:0/5
AccuracySec=30s
Persistent=true
Unit=wecom-archive-worker.service

[Install]
WantedBy=timers.target
