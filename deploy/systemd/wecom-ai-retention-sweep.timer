[Unit]
Description=WeCom Archive AI Support Chat Session Retention Sweep Timer

[Timer]
# Daily — retention windows are measured in days (AI_RETENTION_DAYS,
# default 90), so a daily sweep is frequent enough that expired sessions
# never linger more than ~24h past their window.
OnCalendar=*-*-* 03:30:00
Persistent=true
Unit=wecom-ai-retention-sweep.service

[Install]
WantedBy=timers.target
