[Unit]
Description=WeCom Archive Recent Media Download (RND-168/RND-199, one shot)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=wecomarchive
WorkingDirectory=/srv/apps/wecom-archive-365/current/backend
EnvironmentFile=/srv/apps/wecom-archive-365/current/backend/.env
ExecStart=/srv/apps/wecom-archive-365/current/backend/.venv/bin/python scripts/download_wecom_media_once.py --since-hours 72 --newest-first --limit 20

# Security hardening (safe subset — must not break access to any of:
# backend directory, .env, database path, SDK library path, storage root,
# and the shared media-download lock path)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/apps/wecom-archive-365
ReadOnlyPaths=/usr /etc

# Do NOT use PrivateTmp=true — the shared media-download lock path lives
# on the real filesystem (see MEDIA_DOWNLOAD_LOCK_PATH) and must stay
# visible across every invocation of this service.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
