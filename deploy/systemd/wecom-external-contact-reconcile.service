[Unit]
Description=WeCom External-contact Daily Full Reconciliation
After=network-online.target postgresql.service
Wants=network-online.target
# GH-107: alert on unit failure (see deploy/systemd/wecom-job-failure-alert@.service)
OnFailure=wecom-job-failure-alert@%n.service

[Service]
Type=oneshot
User=wecomarchive
WorkingDirectory=/srv/apps/wecom-archive-365/current/backend
EnvironmentFile=/srv/apps/wecom-archive-365/current/backend/.env
ExecStart=/srv/apps/wecom-archive-365/current/backend/.venv/bin/python -m app.services.external_contact_sync

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/apps/wecom-archive-365
ReadOnlyPaths=/usr /etc
PrivateTmp=false
