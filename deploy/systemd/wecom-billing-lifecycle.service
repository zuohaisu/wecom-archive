[Unit]
Description=WeCom Archive Billing Lifecycle Batch
After=network-online.target postgresql.service
Wants=network-online.target
# GH-107: alert on unit failure (see deploy/systemd/wecom-job-failure-alert@.service)
OnFailure=wecom-job-failure-alert@%n.service

[Service]
Type=oneshot
User=wecomarchive
WorkingDirectory=/srv/apps/wecom-archive-365/current/backend
EnvironmentFile=/srv/apps/wecom-archive-365/current/backend/.env
ExecStart=/srv/apps/wecom-archive-365/current/backend/.venv/bin/python scripts/process_billing_lifecycle_once.py

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/apps/wecom-archive-365
ReadOnlyPaths=/usr /etc
PrivateTmp=true

[Install]
WantedBy=multi-user.target
