# Wildcard config for qiniu-ssl-renew-wildcard (GH-104 Follow-up B).
#
# Install as: /etc/qiniu-ssl-renew/media.crowntime.cn.env (mode 600, owned
# by the service user). This is a DIFFERENT flow from
# examples/domain.env.example / qiniu-ssl-renew@<domain>: that template
# renews a single Qiniu Kodo CDN custom-domain certificate and does not
# touch nginx; this one renews ONE wildcard certificate (*.crowntime.cn)
# and deploys it to both Qiniu (CDN + origin domain bindings) and the
# nginx-fronted vhosts on this host. See
# https://github.com/zuohaisu/wecom-archive/wiki/Wildcard-SSL-Renewal for the full behavior and
# failure-policy contract.
#
# No secret VALUE belongs in version control — this file documents names
# only. Real values live solely in the EnvironmentFile above.

# ── Required (production's actual env file sets these) ─────────────────

# NOT read by renew-wildcard.sh -- the wildcard domain is a hardcoded
# constant in the script itself (see
# https://github.com/zuohaisu/wecom-archive/wiki/Wildcard-SSL-Renewal). Kept here only for the same
# per-instance-env-file naming convention every other domain.env in this
# subsystem uses. (ORIGIN_DOMAIN below IS read since GH-231.)
DOMAIN=crowntime.cn

QINIU_ACCESS_KEY=__REPLACE_ME__
QINIU_SECRET_KEY=__REPLACE_ME__

# Interpreter used to invoke qiniu_helper.py (lib/qiniu.sh default: python3).
# QINIU_HELPER_PYTHON=python3

# Read directly by verify_https.sh if/when it is ever invoked against this
# domain manually -- not consumed by renew-wildcard.sh's own pipeline.
# Leave unset unless an operator has a specific, understood reason to skip
# system-trust-store chain verification for this domain.
# VERIFY_HTTPS_SKIP_CHAIN=1

# Alert delivery for hard failures is provided by the service's canonical
# systemd OnFailure= hook, whose alert unit reads gitignored backend/.env
# rather than this EnvironmentFile. Kept here only for subsystem convention;
# do not assume this value alone configures alert delivery.
# ALERT_WEBHOOK_URL=https://example.com/hooks/ssl-renew

# ── Reconciliation (GH-231, read by renew-wildcard.sh) and optional
#    overrides ─────────────────────────────────────────────────────────

# Qiniu CDN / origin domains this wildcard certificate is bound to.
# CDN_DOMAIN remains hardcoded in the script (media.crowntime.cn).
# ORIGIN_DOMAIN is READ since GH-231: setting it opts this environment into
# the origin bind (on deploy) and the per-run binding reconciliation
# (CDN + origin) against the newest local certificate. Unset ⇒ no origin
# activity at all — behavior identical to pre-GH-231.
# CDN_DOMAIN=media.crowntime.cn
ORIGIN_DOMAIN=media-origin.crowntime.cn

# GH-231 optional: which bucket the reconciled domains belong to. Log
# diagnostics context only — never used in any API request.
# QINIU_BUCKET=365-wecom-media

# GH-231 optional: a bound certificate expiring within this many days is
# reconciled even when its fingerprint matches the newest local cert.
# Must be a non-negative integer; invalid values warn and fall back to 14.
# ORIGIN_CERT_MIN_VALID_DAYS=14

# Where acme.sh keeps the issued wildcard certificate and where
# renew-wildcard.sh keeps its own state (.deployed_fp).
# CERT_DIR=/home/wecomarchive/.acme.sh/crowntime.cn

# Path to the acme.sh executable. The systemd unit also sets
# Environment=HOME=/home/wecomarchive directly (not via this file) so this
# default resolves correctly even though systemd services don't otherwise
# inherit a shell $HOME.
# ACME_SH=/home/wecomarchive/.acme.sh/acme.sh

# DNSPod DNS-01 provider alias passed to acme.sh --dns.
# DNS_PROVIDER=dns_dp

# Directory the renewed fullchain/privkey are copied into for nginx to
# serve (crowntime.cn, www.crowntime.cn, archive.example.com,
# staging-archive.crowntime.cn — see https://github.com/zuohaisu/wecom-archive/wiki/Wildcard-SSL-Renewal
# for the authoritative, Ops-confirmed vhost list; archive.crowntime.cn is
# NOT served by this certificate). The script does NOT create this
# directory if it's missing; that stage warns and needs operator remediation.
# NGINX_CERT_DIR=/srv/apps/wecom-archive-365/shared/certs/wildcard.crowntime.cn
