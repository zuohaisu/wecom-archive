# Per-domain instance config for qiniu-ssl-renew@<domain>.
#
# Install as: /etc/qiniu-ssl-renew/<domain>.env  (mode 600, owned by the
# service user — see install.sh). systemd loads it via EnvironmentFile=
# in deploy/systemd/qiniu-ssl-renew@.service before renew.sh starts.
#
# Adding a new domain = copy this file, fill it in, enable a new systemd
# instance. The core scripts (renew.sh / notify.sh / verify_https.sh) are
# never touched or duplicated.

# ── Required ─────────────────────────────────────────────────────────────

# Must match the systemd instance name (%i), i.e. the file name without
# .env. renew.sh cross-checks this and refuses to run on a mismatch.
DOMAIN=media.crowntime.cn

QINIU_ACCESS_KEY=__REPLACE_ME__
QINIU_SECRET_KEY=__REPLACE_ME__

# ── Optional overrides (defaults shown) ────────────────────────────────

# DNSPod DNS-01 provider alias passed to acme.sh --dns.
# DNS_PROVIDER=dns_dp

# Where acme.sh keeps the issued certificate for this domain, and where
# renew.sh keeps its own state (.deployed_fp / .tls_verified / lock file).
# Must be unique per domain — the default (keyed by $DOMAIN) already is.
# CERT_DIR=/home/wecomarchive/.acme.sh/media.crowntime.cn
# STATE_DIR=/home/wecomarchive/.acme.sh/media.crowntime.cn

# Path to the acme.sh executable.
# ACME_SH=/home/wecomarchive/.acme.sh/acme.sh

# Minimum remaining certificate validity (days) verify_https.sh requires.
# TLS_MIN_DAYS=15

# How many consecutive daily HTTPS-verification mismatches are tolerated
# before renew.sh gives up and pages a human.
# TLS_MISMATCH_DAYS_LIMIT=7

# Generic webhook for alerts. Leave unset to degrade to log-only (clearly
# marked [DEGRADED] in the log — not a silent no-op).
# ALERT_WEBHOOK_URL=https://example.com/hooks/ssl-renew
# ALERT_WEBHOOK_TIMEOUT=10
